{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/index.ts",
    "src/cli.ts"
  ],
  "ignoreDependencies": [
    // The real integration test resolves this package's dsh binary by absolute path.
    "@deepseek-ai/dsh"
  ],
  "ignoreBinaries": [
    // Isolated Caddy/Nginx checks and leftover template validation use host binaries.
    "nginx"
  ]
}

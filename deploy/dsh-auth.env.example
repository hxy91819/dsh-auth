# Identity is public configuration. Keep userId stable if username changes.
DSH_AUTH_USER_ID=replace-with-stable-user-id
DSH_AUTH_USERNAME=replace-with-username
DSH_AUTH_ROLES=admin

# Literal Nginx source IPs allowed to set forwarded client/origin fields.
DSH_AUTH_TRUSTED_PROXY_ADDRESSES=127.0.0.1,::1

# Prefer orchestrator-mounted files. Contents are intentionally absent here.
DSH_AUTH_PASSWORD_HASH_FILE=/run/secrets/dsh_auth_password_hash
DSH_AUTH_SESSION_SECRET_FILE=/run/secrets/dsh_auth_session_secret

# Keep true for normal HTTPS deployments. False permits plain HTTP and removes
# the Secure attribute and __Host- prefix from authentication cookies.
DSH_AUTH_SECURE_COOKIES=true

# Optional session and login policy.
DSH_AUTH_SESSION_TTL_SECONDS=28800
DSH_AUTH_IDLE_TTL_SECONDS=3600
DSH_AUTH_MAX_SESSIONS=16
DSH_AUTH_MAX_PASSWORD_BYTES=1024
DSH_AUTH_LOGIN_WINDOW_SECONDS=60
DSH_AUTH_LOGIN_MAX_ATTEMPTS=5
DSH_AUTH_LOGIN_BLOCK_SECONDS=300

# Paths and non-secret policy. Secret values live in separate permission-restricted files.
DSH_AUTH_STATE_FILE=/var/lib/dsh-auth/auth-state.json
DSH_AUTH_SESSION_SECRET_FILE=/etc/dsh-auth/session-secret
DSH_AUTH_LOGIN_TOKEN_ENABLED=true
DSH_AUTH_LOGIN_TOKEN_DIRECTORY=/var/lib/dsh-auth/login-tokens

# Literal Caddy source IPs allowed to set forwarded client/origin fields.
DSH_AUTH_TRUSTED_PROXY_ADDRESSES=127.0.0.1,::1

# Keep true for normal HTTPS deployments. False permits plain HTTP and removes
# the Secure attribute and __Host- prefix from authentication cookies.
DSH_AUTH_SECURE_COOKIES=true

# Optional session and login policy.
DSH_AUTH_SESSION_TTL_SECONDS=259200
DSH_AUTH_IDLE_TTL_SECONDS=259200
DSH_AUTH_SESSION_RENEWAL_SECONDS=3600
DSH_AUTH_MAX_SESSIONS=16
DSH_AUTH_LOGIN_WINDOW_SECONDS=60
DSH_AUTH_LOGIN_MAX_ATTEMPTS=5
DSH_AUTH_LOGIN_BLOCK_SECONDS=300
DSH_AUTH_LOGIN_TOKEN_WINDOW_SECONDS=60
DSH_AUTH_LOGIN_TOKEN_MAX_ATTEMPTS=10
DSH_AUTH_LOGIN_TOKEN_BLOCK_SECONDS=300

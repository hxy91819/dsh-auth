{
	admin off
	auto_https off
}

http://{{SITE_HOST}}:{{HTTP_PORT}}, http://:{{HTTP_PORT}} {
	bind {{LISTEN_ADDRESS}}

	header {
		{{STRICT_TRANSPORT_SECURITY}}
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		?Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	route {
		{{FORWARDED_GUARD}}

		@public_verify path /auth/verify
		respond @public_verify 404

		@auth path /auth /auth/*
		handle @auth {
			request_body {
				max_size 20KiB
			}
			reverse_proxy {{UPSTREAM}} {
				header_up Host {upstream_hostport}
				header_up X-Forwarded-Host {{FORWARDED_HOST}}
				header_up X-Forwarded-Proto {{FORWARDED_PROTO}}
				header_up X-Real-IP {{REAL_IP}}
			}
		}

		request_body {
			max_size 170MiB
		}

		intercept {
			@auth_denied {
				status 401
				header X-Dsh-Auth-Login *
			}
			handle_response @auth_denied {
				@interactive not path /api /api/* /plugins/events
				handle @interactive {
					header Location {resp.header.X-Dsh-Auth-Login}
					respond 303
				}
			}
		}

		request_header -X-Dsh-Auth-User-Id
		request_header -X-Dsh-Auth-Username
		request_header -X-Dsh-Auth-Roles
		request_header -X-Dsh-Auth-Renewal
		{{CLEAR_FORWARDED_HEADERS}}
		request_header -X-Original-Method
		request_header -X-Original-URI
		request_header -X-Original-Upgrade
		request_header -X-Dsh-Auth-Original-Method
		request_header -X-Dsh-Auth-Original-URI
		request_header -X-Dsh-Auth-Original-Upgrade
		request_header X-Dsh-Auth-Original-Method {method}
		request_header X-Dsh-Auth-Original-URI {uri}
		@upgrade header Upgrade *
		request_header @upgrade X-Dsh-Auth-Original-Upgrade {header.Upgrade}

		forward_auth {{UPSTREAM}} {
			uri /auth/verify
			header_up -Connection
			header_up -Upgrade
			header_up Host {upstream_hostport}
			header_up X-Forwarded-Host {{FORWARDED_HOST}}
			header_up X-Forwarded-Proto {{FORWARDED_PROTO}}
			header_up X-Real-IP {{REAL_IP}}
			header_up X-Original-URI {header.X-Dsh-Auth-Original-URI}
			header_up X-Original-Method {header.X-Dsh-Auth-Original-Method}
			header_up X-Original-Upgrade {header.X-Dsh-Auth-Original-Upgrade}
			copy_headers X-Dsh-Auth-User-Id X-Dsh-Auth-Username X-Dsh-Auth-Roles Set-Cookie>X-Dsh-Auth-Renewal
		}

		@renewed expression `{http.request.header.X-Dsh-Auth-Renewal} != ""`
		header @renewed +Set-Cookie {http.request.header.X-Dsh-Auth-Renewal}
		request_header -X-Dsh-Auth-Renewal
		request_header -X-Dsh-Auth-Original-Method
		request_header -X-Dsh-Auth-Original-URI
		request_header -X-Dsh-Auth-Original-Upgrade

		reverse_proxy {{UPSTREAM}} {
			flush_interval -1
			header_up Host {upstream_hostport}
			header_up X-Forwarded-Host {{FORWARDED_HOST}}
			header_up X-Forwarded-Proto {{FORWARDED_PROTO}}
			header_up X-Real-IP {{REAL_IP}}
			header_up Origin http://{upstream_hostport}
		}
	}
}

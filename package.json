{
  "name": "dsh-auth",
  "version": "0.1.13",
  "description": "Nginx-fronted single-account authentication bundle for DeepSeek Harness",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-auth": "./lib/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hxy91819/dsh-auth.git"
  },
  "homepage": "https://github.com/hxy91819/dsh-auth#readme",
  "bugs": {
    "url": "https://github.com/hxy91819/dsh-auth/issues"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "cordis.overlay.yml",
    "deploy/",
    "docs/installer.md",
    "CHANGELOG.md",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=24.7.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.7 <0.2.0",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.7 <0.2.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.0-rc.7 <0.2.0",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.1.0-rc.7 <0.2.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.7 <0.2.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.7 <0.2.0",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.7 <0.2.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-sidebar": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown && node scripts/mark-bin.mjs",
    "clean": "tsc --build --clean tsconfig.build.json",
    "test": "vitest run",
    "test:e2e": "node scripts/real-integration.mjs",
    "test:e2e:latest-dsh": "node scripts/latest-harness-e2e.mjs",
    "test:integration:real": "pnpm run test:e2e",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "check:duplicates": "jscpd --config jscpd.json",
    "check:imports": "depcruise --config .dependency-cruiser.cjs --output-type err-long src",
    "check:dead-code": "knip --config knip.jsonc",
    "check:package": "publint",
    "check:code-health": "pnpm run lint && pnpm run check:duplicates && pnpm run check:imports && pnpm run check:dead-code",
    "check:functional": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run check:package",
    "report:code-health": "mkdir -p .tmp/code-health/production .tmp/code-health/report && eslint src --format json --output-file .tmp/code-health/production/eslint.json && eslint tests scripts --format json --output-file .tmp/code-health/report/eslint.json && jscpd --config jscpd-report.json",
    "check:nginx": "pnpm run build && node scripts/check-nginx.mjs",
    "check": "pnpm run check:code-health && pnpm run check:functional",
    "prepack": "tsc --build --clean tsconfig.build.json && pnpm run build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@deepseek-ai/dsh-subprocess-local",
      "node-pty"
    ]
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-locale": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-settings-general": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.7",
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.7",
    "@deepseek-ai/dsh-settings": "0.1.0-rc.7",
    "@eslint/js": "9.39.5",
    "@standard-schema/spec": "1.1.0",
    "@types/node": "24.13.3",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "dependency-cruiser": "18.2.0",
    "eslint": "9.33.0",
    "eslint-plugin-sonarjs": "4.2.0",
    "globals": "17.11.0",
    "jscpd": "5.0.15",
    "jsdom": "30.0.1",
    "knip": "6.32.2",
    "publint": "0.3.23",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.22.14",
    "typescript": "5.9.2",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10",
    "ws": "8.21.3"
  },
  "keywords": [
    "deepseek-harness",
    "cordis",
    "nginx",
    "authentication",
    "argon2id"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.14.0"
}
